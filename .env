# ===================================================================
# Mầm Xanh LMS 2.0 - Environment Configuration
# ===================================================================
COMPOSE_PROJECT_NAME=mamxanh_lms

# Ports (HTTPS canonical on 8443; HTTP on 8088 because host port 8080 is used by Workato AgentService)
HTTPS_PORT=8443
HTTP_PORT=8088
MOODLE_WWWROOT=https://moodle.lvh.me:8443

# MariaDB 10.11 Credentials
MOODLE_DB_HOST=moodle_db
MOODLE_DB_NAME=moodle_mamxanh
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASS=MX!DbPass2026
MYSQL_ROOT_PASSWORD=MX!RootDb2026

# Redis 7 Credentials
REDIS_HOST=moodle_redis
REDIS_PORT=6379

# Digital Certificate HMAC-SHA256 Signing Secret
MAMXANH_HMAC_SECRET=MX2_HMAC_2026_VIETGAP_AGRITECH_DIGITAL_SIGNATURE_KEY
