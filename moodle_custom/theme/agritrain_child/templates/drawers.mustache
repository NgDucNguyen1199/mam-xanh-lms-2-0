{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}
                {{> theme_boost/courseindexdrawercontrols}}
            {{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">

            <!-- Minimal secondary tab row (Wayfinding Navigation) -->
            {{#showsubnav}}
            <nav class="mx-subnav d-print-none" aria-label="{{ lbl_subnav }}">
                <div class="mx-subnav-inner">
                    <a href="{{{ mxmyurl }}}" class="{{#navmyactive}}active{{/navmyactive}}">{{ lbl_nav_my }}</a>
                    <a href="{{{ mxmamxanhurl }}}" class="{{#navmamxanhactive}}active{{/navmamxanhactive}}">{{ lbl_nav_mamxanh }}</a>
                    {{#iscbktadmin}}
                    <a href="{{{ mxclonerurl }}}" class="{{#navcloneractive}}active{{/navcloneractive}}">{{ lbl_nav_cloner }}</a>
                    {{/iscbktadmin}}
                    {{^iscbktadmin}}
                    <a href="{{{ mxcourseurl }}}" class="{{#navcourseactive}}active{{/navcourseactive}}">{{ lbl_nav_course }}</a>
                    {{/iscbktadmin}}
                    <a href="{{{ mxagriopsurl }}}" class="{{#navagriactive}}active{{/navagriactive}}">{{ lbl_nav_agri }}</a>
                    {{^iscbktadmin}}
                    <a href="{{{ mxcalcurl }}}" class="{{#navcalcactive}}active{{/navcalcactive}}">{{ lbl_nav_calc }}</a>
                    {{/iscbktadmin}}
                    <a href="{{{ mxcerturl }}}" class="{{#navcertactive}}active{{/navcertactive}}">{{ lbl_nav_cert }}</a>
                    {{^iscbktadmin}}
                    <a href="{{{ mxprofileurl }}}" class="{{#navprofactive}}active{{/navprofactive}}">{{ lbl_nav_prof }}</a>
                    {{/iscbktadmin}}
                    <span class="mx-subnav-lang">
                        <a href="{{{ langviurl }}}" class="{{#isvi}}active{{/isvi}}" id="mx-switch-vi">VI</a>
                        <span aria-hidden="true">/</span>
                        <a href="{{{ langenurl }}}" class="{{#isen}}active{{/isen}}" id="mx-switch-en">EN</a>
                    </span>
                </div>
            </nav>
            {{/showsubnav}}


            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-courseindex"
                            data-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerindex, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                            {{#pix}} t/index_drawer, moodle {{/pix}}
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-blocks"
                            data-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>

            {{^isdashboard}}
            {{{ output.full_header }}}
            {{/isdashboard}}

            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none">
                    {{> core/moremenu}}
                </div>
            {{/secondarymoremenu}}

            {{#ismyindex}}
            <div class="mx-dashboard-customise-bar d-flex justify-content-between align-items-center mb-3 px-3 d-print-none">
                <div class="mx-dashboard-breadcrumbs">
                    <span class="text-muted small">Dashboard &gt; My courses</span>
                </div>
                <div class="mx-dashboard-actions d-flex gap-2">
                    {{#is_editing}}
                    <a href="{{{ resetpageurl }}}" class="btn btn-sm btn-secondary mx-btn-reset">{{ str_resetpage }}</a>
                    <a href="{{{ stopediturl }}}" class="btn btn-sm btn-primary mx-btn-stopedit">{{ str_stopedit }}</a>
                    {{/is_editing}}
                    {{^is_editing}}
                    <a href="{{{ startediturl }}}" class="btn btn-sm btn-primary mx-btn-startedit">{{ str_startedit }}</a>
                    {{/is_editing}}
                </div>
            </div>
            {{/ismyindex}}

            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    {{#hasregionmainsettingsmenu}}
                    <div id="region-main-settings-menu" class="d-print-none">
                        <div> {{{ regionmainsettingsmenu }}} </div>
                    </div>
                    {{/hasregionmainsettingsmenu}}
                    <div id="region-main">
                        {{#hasregionmainsettingsmenu}}
                            <div class="region_main_settings_menu_proxy"></div>
                        {{/hasregionmainsettingsmenu}}

                        <!-- Top Lesson/Course Back Button -->
                        {{#mxhasback}}
                        <div class="mx-back-nav-bar d-print-none">
                            <a href="{{{ mxbackurl }}}" class="mx-back-nav-btn">{{ mxbacklabel }}</a>
                        </div>
                        {{/mxhasback}}


                        {{{ output.course_content_header }}}
                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/url_select}}
                                </div>
                            </div>
                        {{/overflow}}

                        <!-- Custom Course Cards/Tiles UI (when viewing course) -->
                        {{{ mxcoursetileshtml }}}

                        {{{ output.main_content }}}
                        {{{ output.activity_navigation }}}
                        {{{ output.course_content_footer }}}

                        <!-- Bottom Lesson/Course Back Button -->
                        {{#mxhasback}}
                        <div class="mx-back-nav-bar mt-4 d-print-none">
                            <a href="{{{ mxbackurl }}}" class="mx-back-nav-btn">{{ mxbacklabel }}</a>
                        </div>
                        {{/mxhasback}}
                    </div>
                </div>
            </div>
        </div>
        {{> theme_boost/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>


<script>

// 4. Automatic .table-responsive Wrapper & PWA Registration
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('#region-main table').forEach(function(tbl) {
        if (!tbl.closest('.table-responsive')) {
            var wrap = document.createElement('div');
            wrap.className = 'table-responsive';
            tbl.parentNode.insertBefore(wrap, tbl);
            wrap.appendChild(tbl);
        }
    });

    var isEn = document.documentElement.lang && document.documentElement.lang.indexOf('en') === 0;

    // 5. Inline Embedded PDF Reader (650px Desktop / 480px Mobile + Zoom +/- Controls, Zero Download)
    var pdfBox = document.querySelector('.resourcecontent.resourcepdf');
    var pdfIframe = document.getElementById('resourceobject');
    if (pdfBox && pdfIframe && pdfIframe.src) {
        var pdfUrl = pdfIframe.src;
        var shell = document.createElement('div');
        shell.className = 'mx-pdf-viewer-shell';
        shell.id = 'mx-inline-pdf-viewer';

        var toolbar = document.createElement('div');
        toolbar.className = 'mx-pdf-toolbar';
        toolbar.innerHTML =
            '<div class="mx-pdf-toolbar-left">' +
                '<span class="mx-pdf-badge">' +
                    (isEn ? 'Document viewer' : 'Xem tài liệu trực tiếp') +
                '</span>' +
                '<span id="mx-pdf-page-count" class="mx-pdf-pagecount"></span>' +
            '</div>' +
            '<div class="mx-pdf-toolbar-right">' +
                '<a class="mx-pdf-zoom-btn" id="mx-pdf-download" href="' + pdfUrl + (pdfUrl.indexOf('?') === -1 ? '?' : '&') + 'forcedownload=1">' + (isEn ? 'Download' : 'Tải về') + '</a>' +
                '<button type="button" class="mx-pdf-zoom-btn" id="mx-pdf-zoom-out" title="Zoom Out">' + (isEn ? 'Zoom Out' : 'Thu nhỏ') + '</button>' +
                '<span id="mx-pdf-zoom-pct" class="mx-pdf-zoompct">100%</span>' +
                '<button type="button" class="mx-pdf-zoom-btn" id="mx-pdf-zoom-in" title="Zoom In">' + (isEn ? 'Zoom In' : 'Phóng to') + '</button>' +
                '<button type="button" class="mx-pdf-zoom-btn" id="mx-pdf-zoom-fit" title="Reset Zoom">' + (isEn ? 'Fit' : 'Vừa khung') + '</button>' +
                '<button type="button" class="mx-pdf-zoom-btn" id="mx-pdf-fullscreen" title="Fullscreen">' + (isEn ? 'Fullscreen' : 'Toàn màn hình') + '</button>' +
            '</div>';

        var viewport = document.createElement('div');
        viewport.className = 'mx-pdf-viewport';
        viewport.id = 'mx-pdf-viewport';

        var canvasList = document.createElement('div');
        canvasList.id = 'mx-pdf-canvas-list';
        viewport.appendChild(canvasList);

        // Detached fallback container for native iframe (kept out of viewport)
        var fallbackContainer = document.createElement('div');
        fallbackContainer.id = 'mx-pdf-fallback';
        fallbackContainer.style.display = 'none';
        fallbackContainer.style.width = '100%';
        fallbackContainer.style.height = '650px';

        pdfBox.parentNode.insertBefore(shell, pdfBox);
        shell.appendChild(toolbar);
        shell.appendChild(viewport);
        shell.appendChild(fallbackContainer);

        pdfIframe.style.display = 'none';
        fallbackContainer.appendChild(pdfIframe);
        pdfBox.remove();

        var currentZoom = 1.0;
        var loadedPdfDoc = null;

        function renderAllPdfPages() {
            if (!loadedPdfDoc) return;
            canvasList.innerHTML = '';
            var vw = Math.max(300, viewport.clientWidth - 36);
            var dpr = Math.min(window.devicePixelRatio || 1, 2);

            var chain = Promise.resolve();
            for (var p = 1; p <= loadedPdfDoc.numPages; p++) {
                (function(pageNum) {
                    chain = chain.then(function() {
                        return loadedPdfDoc.getPage(pageNum).then(function(page) {
                            var baseVp = page.getViewport({ scale: 1.0 });
                            var fitScale = Math.min(1.35, vw / baseVp.width);
                            var finalScale = fitScale * currentZoom;
                            var vp = page.getViewport({ scale: finalScale });

                            var wrap = document.createElement('div');
                            wrap.className = 'mx-pdf-page-wrap';

                            var lbl = document.createElement('div');
                            lbl.className = 'mx-pdf-page-label';
                            lbl.textContent = (isEn ? 'Page ' : 'Trang ') + pageNum + ' / ' + loadedPdfDoc.numPages;

                            var canvas = document.createElement('canvas');
                            canvas.className = 'mx-pdf-page-canvas';
                            canvas.width = Math.floor(vp.width * dpr);
                            canvas.height = Math.floor(vp.height * dpr);
                            canvas.style.width = Math.floor(vp.width) + 'px';
                            canvas.style.height = Math.floor(vp.height) + 'px';

                            wrap.appendChild(lbl);
                            wrap.appendChild(canvas);
                            canvasList.appendChild(wrap);

                            var ctx = canvas.getContext('2d');
                            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                            return page.render({ canvasContext: ctx, viewport: vp }).promise;
                        });
                    });
                })(p);
            }
            chain.then(function() {
                shell.setAttribute('data-pdf-rendered', 'true');
            });
        }

        function updateZoom(newZoom) {
            currentZoom = Math.max(0.6, Math.min(2.2, Math.round(newZoom * 100) / 100));
            var pctEl = document.getElementById('mx-pdf-zoom-pct');
            if (pctEl) pctEl.textContent = Math.round(currentZoom * 100) + '%';
            if (loadedPdfDoc) {
                renderAllPdfPages();
            } else if (pdfIframe) {
                pdfIframe.style.transform = 'scale(' + currentZoom + ')';
                pdfIframe.style.transformOrigin = 'top center';
            }
        }

        document.getElementById('mx-pdf-zoom-in').addEventListener('click', function() { updateZoom(currentZoom + 0.2); });
        document.getElementById('mx-pdf-zoom-out').addEventListener('click', function() { updateZoom(currentZoom - 0.2); });
        document.getElementById('mx-pdf-zoom-fit').addEventListener('click', function() { updateZoom(1.0); });
        document.getElementById('mx-pdf-fullscreen').addEventListener('click', function() {
            if (shell.requestFullscreen) {
                if (!document.fullscreenElement) shell.requestFullscreen();
                else document.exitFullscreen();
            }
        });

        function activateFallback() {
            if (viewport && viewport.parentNode) viewport.style.display = 'none';
            if (fallbackContainer) fallbackContainer.style.display = 'block';
            if (pdfIframe) {
                pdfIframe.style.display = 'block';
                pdfIframe.style.width = '100%';
                pdfIframe.style.height = '650px';
            }
        }

        function initPdfJsViewer(pdfLib) {
            if (!pdfLib) {
                activateFallback();
                return;
            }
            pdfLib.GlobalWorkerOptions.workerSrc = '/local/mamxanhapp/assets/pdfjs/pdf.worker.min.js';
            pdfLib.getDocument({ url: pdfUrl, withCredentials: true }).promise.then(function(pdfDoc) {
                loadedPdfDoc = pdfDoc;
                var cnt = document.getElementById('mx-pdf-page-count');
                if (cnt) cnt.textContent = '' + pdfDoc.numPages + (isEn ? ' pages' : ' trang kỹ thuật');
                // PDF.js successfully rendered document -> permanently destroy fallback iframe to prevent duplicate/gray bottom box
                if (pdfIframe && pdfIframe.parentNode) {
                    pdfIframe.remove();
                }
                if (fallbackContainer && fallbackContainer.parentNode) {
                    fallbackContainer.remove();
                }
                renderAllPdfPages();
            }).catch(function() {
                activateFallback();
            });
        }

        var s = document.createElement('script');
        s.src = '/local/mamxanhapp/assets/pdfjs/pdf.min.js';
        s.onload = function() {
            if (window.pdfjsLib) {
                initPdfJsViewer(window.pdfjsLib);
            } else if (typeof window.require === 'function') {
                window.require(['pdfjs-dist/build/pdf'], function(lib) {
                    initPdfJsViewer(lib || window.pdfjsLib);
                }, function() {
                    activateFallback();
                });
            } else {
                activateFallback();
            }
        };
        s.onerror = function() {
            activateFallback();
        };
        document.head.appendChild(s);
    }

    // 6. H5P Navigation Buttons Auto-Fix (Supplies clear context, text labels & styling to empty navigation buttons)
    function initH5pButtonsEnhancer() {
        var isEn = (document.documentElement.lang || '').toLowerCase().indexOf('en') === 0;

        function enhanceDoc(doc) {
            if (!doc) return;
            var btns = doc.querySelectorAll('button, .h5p-theme-button, .h5p-joubelui-button, [role="button"]');
            for (var i = 0; i < btns.length; i++) {
                var b = btns[i];
                var aria = (b.getAttribute('aria-label') || b.getAttribute('title') || '').trim();
                var txt = (b.textContent || '').trim();
                var cls = (b.className || '').toLowerCase();

                // If button has NO readable text or only contains empty icon
                if (txt === '' || txt === ' ' || b.children.length === 0 || (b.children.length === 1 && (b.children[0].tagName === 'SPAN' || b.children[0].tagName === 'I') && b.children[0].textContent.trim() === '')) {
                    var labelText = '';
                    var isPrev = cls.indexOf('prev') !== -1 || cls.indexOf('back') !== -1 || aria.indexOf('trước') !== -1 || aria.indexOf('previous') !== -1 || aria.indexOf('back') !== -1;
                    var isNext = cls.indexOf('next') !== -1 || aria.indexOf('tiếp') !== -1 || aria.indexOf('next') !== -1;
                    var isFinish = cls.indexOf('finish') !== -1 || cls.indexOf('submit') !== -1 || cls.indexOf('end') !== -1 || aria.indexOf('thành') !== -1 || aria.indexOf('finish') !== -1 || aria.indexOf('nộp') !== -1;
                    var isRetry = cls.indexOf('retry') !== -1 || cls.indexOf('again') !== -1 || aria.indexOf('lại') !== -1 || aria.indexOf('retry') !== -1;
                    var isSolution = cls.indexOf('solution') !== -1 || aria.indexOf('đáp án') !== -1 || aria.indexOf('solution') !== -1;
                    var isSummary = cls.indexOf('summary') !== -1 || cls.indexOf('result') !== -1 || aria.indexOf('kết quả') !== -1 || aria.indexOf('summary') !== -1;

                    if (isPrev) {
                        labelText = isEn ? 'Previous Question' : 'Câu trước';
                        b.style.setProperty('background-color', '#475569', 'important');
                    } else if (isFinish) {
                        labelText = isEn ? 'Finish Quiz' : 'Hoàn thành';
                        b.style.setProperty('background-color', '#1e3a2f', 'important');
                    } else if (isNext) {
                        labelText = isEn ? 'Next Question' : 'Câu tiếp theo';
                        b.style.setProperty('background-color', '#1e3a2f', 'important');
                    } else if (isRetry) {
                        labelText = isEn ? 'Retry' : 'Làm lại';
                        b.style.setProperty('background-color', '#475569', 'important');
                    } else if (isSolution) {
                        labelText = isEn ? 'Show Solution' : 'Xem đáp án';
                        b.style.setProperty('background-color', '#0369a1', 'important');
                    } else if (isSummary) {
                        labelText = isEn ? 'View Results' : 'Xem kết quả';
                        b.style.setProperty('background-color', '#1e3a2f', 'important');
                    } else if (aria !== '') {
                        labelText = aria;
                        b.style.setProperty('background-color', '#1e3a2f', 'important');
                    } else {
                        // Intelligent fallback based on context: Next or Continue
                        labelText = isEn ? 'Continue' : 'Tiếp tục';
                        b.style.setProperty('background-color', '#1e3a2f', 'important');
                    }

                    b.innerHTML = '<span class="h5p-theme-label" style="font-weight:700;font-size:0.9rem;letter-spacing:0.2px;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;">' + labelText + '</span>';
                    b.style.setProperty('display', 'inline-flex', 'important');
                    b.style.setProperty('align-items', 'center', 'important');
                    b.style.setProperty('justify-content', 'center', 'important');
                    b.style.setProperty('padding', '8px 18px', 'important');
                    b.style.setProperty('min-height', '40px', 'important');
                    b.style.setProperty('min-width', '96px', 'important');
                    b.style.setProperty('color', '#ffffff', 'important');
                    b.style.setProperty('border-radius', '6px', 'important');
                    b.style.setProperty('border', 'none', 'important');
                    b.style.setProperty('cursor', 'pointer', 'important');
                    b.style.setProperty('box-shadow', '0 2px 8px rgba(0,0,0,0.08)', 'important');
                }
            }
        }

        function checkAllIframes() {
            var iframes = document.querySelectorAll('iframe');
            for (var i = 0; i < iframes.length; i++) {
                var f = iframes[i];
                try {
                    var doc = f.contentDocument || (f.contentWindow && f.contentWindow.document);
                    if (doc) {
                        enhanceDoc(doc);
                        if (doc.body && !doc.body.__mxObserved) {
                            doc.body.__mxObserved = true;
                            doc.addEventListener('click', function() { setTimeout(checkAllIframes, 60); setTimeout(checkAllIframes, 300); });
                            var obs = new MutationObserver(function() { enhanceDoc(doc); });
                            obs.observe(doc.body, { childList: true, subtree: true });
                        }

                        var subIframes = doc.querySelectorAll('iframe');
                        for (var j = 0; j < subIframes.length; j++) {
                            var sf = subIframes[j];
                            try {
                                var sdoc = sf.contentDocument || (sf.contentWindow && sf.contentWindow.document);
                                if (sdoc) {
                                    enhanceDoc(sdoc);
                                    if (sdoc.body && !sdoc.body.__mxObserved) {
                                        sdoc.body.__mxObserved = true;
                                        sdoc.addEventListener('click', function() { setTimeout(checkAllIframes, 60); setTimeout(checkAllIframes, 300); });
                                        var sobs = new MutationObserver(function() { enhanceDoc(sdoc); });
                                        sobs.observe(sdoc.body, { childList: true, subtree: true });
                                    }
                                }
                            } catch(e) {}
                        }
                    }
                } catch(e) {}
            }
        }

        checkAllIframes();
        var timer = setInterval(checkAllIframes, 400);
        setTimeout(function() { clearInterval(timer); }, 600000);
    }
    initH5pButtonsEnhancer();

    // Calendar month day click enhancement: direct navigation to day events
    function enhanceCalendarClicks() {
        document.querySelectorAll('.block_calendar_month td.clickable').forEach(function(td) {
            var ts = td.dataset.dayTimestamp;
            if (ts) {
                td.querySelectorAll('a[data-action="view-day-link"]').forEach(function(a) {
                    a.setAttribute('href', '/calendar/view.php?view=day&time=' + ts);
                    a.removeAttribute('tabindex');
                });
                td.style.cursor = 'pointer';
                if (!td.__mxCalBound) {
                    td.__mxCalBound = true;
                    td.addEventListener('click', function(e) {
                        if (!e.target.closest('a')) {
                            window.location.href = '/calendar/view.php?view=day&time=' + ts;
                        }
                    });
                }
            }
        });
    }
    enhanceCalendarClicks();
    setTimeout(enhanceCalendarClicks, 500);
    setTimeout(enhanceCalendarClicks, 1500);
});

if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
    });
}
</script>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
