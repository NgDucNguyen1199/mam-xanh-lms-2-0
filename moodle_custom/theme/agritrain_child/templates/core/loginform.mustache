<div class="loginform mx-login-card-inner">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span style="display:inline-block;background:#eef5f1;color:#1e3a2f;font-weight:700;font-size:0.8rem;padding:4px 10px;border-radius:4px;letter-spacing:0.3px;">
            MẦM XANH LMS 2.0
        </span>
        <div class="mx-lang-pill" id="mx-login-lang-switcher" style="display:inline-flex;gap:4px;font-size:0.82rem;font-weight:600;">
            <a href="?lang=vi" id="mx-lang-vi" style="color:#475569;text-decoration:none;padding:2px 6px;">VI</a>
            <span style="color:#cbd5e1;">/</span>
            <a href="?lang=en" id="mx-lang-en" style="color:#475569;text-decoration:none;padding:2px 6px;">EN</a>
        </div>
    </div>

    <div class="text-center mb-4">
        <h1 class="h5 mb-1" style="color:#0f172a;font-weight:700;letter-spacing:-0.2px;" id="mx-login-title">
            Hệ thống Tập huấn Nông nghiệp Công nghệ cao
        </h1>
        <p class="mb-0" style="color:#64748b;font-size:0.88rem;" id="mx-login-subtitle">
            Học phần Trực tuyến &amp; Quản lý Canh tác Số VietGAP
        </p>
    </div>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance mb-3">
            {{{maintenance}}}
        </div>
    {{/maintenance}}

    {{#error}}
        <a href="#" id="loginerrormessage" class="sr-only">{{error}}</a>
        <div class="alert alert-danger mb-3" role="alert" style="border-radius:6px;font-size:0.88rem;">{{error}}</div>
    {{/error}}

    {{#info}}
        <a href="#" id="logininfomessage" class="sr-only">{{info}}</a>
        <div class="alert alert-info mb-3" role="alert" style="border-radius:6px;font-size:0.88rem;">{{info}}</div>
    {{/info}}

    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            <div class="login-form-username form-group mb-3">
                <label for="username" class="mb-1" style="color:#334155;font-size:0.85rem;font-weight:600;">{{#str}} username {{/str}}</label>
                <input type="text" name="username" id="username"
                    class="form-control"
                    value="{{username}}"
                    placeholder="{{#cleanstr}}username{{/cleanstr}}"
                    autocomplete="username"
                    style="min-height:44px;border-radius:6px;border:1px solid #cbd5e1;font-size:0.92rem;">
            </div>

            <div class="login-form-password form-group mb-3">
                <label for="password" class="mb-1" style="color:#334155;font-size:0.85rem;font-weight:600;">{{#str}} password {{/str}}</label>
                <input type="password" name="password" id="password" value=""
                    class="form-control"
                    placeholder="{{#cleanstr}}password{{/cleanstr}}"
                    autocomplete="current-password"
                    style="min-height:44px;border-radius:6px;border:1px solid #cbd5e1;font-size:0.92rem;">
            </div>

            <div class="login-form-submit mb-3">
                <button class="btn btn-primary w-100" type="submit" id="loginbtn"
                    style="min-height:44px;border-radius:6px;font-weight:600;background:#1e3a2f;border-color:#1e3a2f;font-size:0.95rem;color:#ffffff;">
                    {{#str}}login{{/str}}
                </button>
            </div>
        </form>

        <!-- 1-Click Instant Role Login (CSRF logintoken Preserved) -->
        <div class="mx-instant-login-box" aria-label="1-Click Instant Login">
            <div style="font-size:0.8rem;font-weight:600;color:#64748b;margin-bottom:8px;text-align:center;" id="mx-instant-heading">
                Đăng nhập mẫu thử nghiệm (1-Click Test Login)
            </div>

            <button type="button" id="mx-1click-farmer" class="mx-instant-btn"
                onclick="mxInstantLogin('nd_rau_lamdong', 'MX!Rau2026')">
                <span id="mx-role-farmer-lbl">Nông dân (Học &amp; Nhật ký)</span>
                <span style="font-size:0.75rem;color:#64748b;">nd_rau_lamdong</span>
            </button>

            <button type="button" id="mx-1click-cbkt" class="mx-instant-btn"
                onclick="mxInstantLogin('cbkt_pilot', 'MX!Canbo2026')">
                <span id="mx-role-cbkt-lbl">Cán bộ Kỹ thuật (Chấm &amp; Báo cáo)</span>
                <span style="font-size:0.75rem;color:#64748b;">cbkt_pilot</span>
            </button>

            <button type="button" id="mx-1click-admin" class="mx-instant-btn"
                onclick="mxInstantLogin('admin', 'Admin!2026MX')">
                <span id="mx-role-admin-lbl">Quản trị viên Hệ thống</span>
                <span style="font-size:0.75rem;color:#64748b;">admin</span>
            </button>
        </div>
    {{/showloginform}}
</div>

<script>
function mxInstantLogin(user, pass) {
    var form = document.getElementById('login');
    var uInput = document.getElementById('username');
    var pInput = document.getElementById('password');
    if (!form || !uInput || !pInput) {
        return;
    }
    uInput.value = user;
    pInput.value = pass;
    var btn = document.getElementById('loginbtn');
    if (btn) {
        btn.click();
    } else {
        form.submit();
    }
}

(function() {
    var isEn = document.documentElement.lang && document.documentElement.lang.indexOf('en') === 0;
    var viBtn = document.getElementById('mx-lang-vi');
    var enBtn = document.getElementById('mx-lang-en');
    if (viBtn && enBtn) {
        if (isEn) {
            enBtn.style.color = '#1e3a2f';
            enBtn.style.fontWeight = '700';
            document.getElementById('mx-login-title').textContent = 'High-Tech Agriculture Training LMS';
            document.getElementById('mx-login-subtitle').textContent = 'Online Academic Modules & VietGAP Traceability';
            var h = document.getElementById('mx-instant-heading');
            if (h) h.textContent = '1-Click Instant Role Login';
            var rf = document.getElementById('mx-role-farmer-lbl');
            if (rf) rf.textContent = 'Farmer (Learning & Diary)';
            var rc = document.getElementById('mx-role-cbkt-lbl');
            if (rc) rc.textContent = 'Tech Officer (Grading & Reports)';
            var ra = document.getElementById('mx-role-admin-lbl');
            if (ra) ra.textContent = 'System Administrator';
        } else {
            viBtn.style.color = '#1e3a2f';
            viBtn.style.fontWeight = '700';
        }
    }
})();
</script>
