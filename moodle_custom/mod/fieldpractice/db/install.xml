<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/fieldpractice/db" VERSION="20261107" COMMENT="Field practice garden attendance via rotating QR + GPS and 4-criteria Rubric grading">
  <TABLES>
    <TABLE NAME="fieldpractice" COMMENT="Field practice activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="location_name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="Vườn Thực nghiệm Mầm Xanh" SEQUENCE="false"/>
        <FIELD NAME="target_lat" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="11.940419" SEQUENCE="false"/>
        <FIELD NAME="target_lng" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="108.458313" SEQUENCE="false"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
        <FIELD NAME="qr_secret" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="MX2_FIELD_QR" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="fieldpractice_sub" COMMENT="Farmer QR+GPS attendance and 4-criteria Rubric grades">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="fieldpracticeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="checkin_code" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="gps_lat" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="gps_lng" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="checkin_note" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="checkin_time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="crit_prep" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="crit_tech" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="crit_biosafe" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="crit_quality" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="total_grade" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="feedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="graderid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="graded_time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_fp" TYPE="foreign" FIELDS="fieldpracticeid" REFTABLE="fieldpractice" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uq_fp_user" UNIQUE="true" FIELDS="fieldpracticeid,userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
