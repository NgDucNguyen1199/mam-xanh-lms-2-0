<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/farmerprofile/db" VERSION="20261107" COMMENT="Farmer household profile and GPS cohort sync">
  <TABLES>
    <TABLE NAME="local_farmerprofile" COMMENT="Stores farm household metadata, GPS coordinates, and synced regional cohort">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="farm_name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="area_m2" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1000" SEQUENCE="false"/>
        <FIELD NAME="main_crop" TYPE="char" LENGTH="120" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="region" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Lâm Đồng" SEQUENCE="false"/>
        <FIELD NAME="gps_lat" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="11.940419" SEQUENCE="false"/>
        <FIELD NAME="gps_lng" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="108.458313" SEQUENCE="false"/>
        <FIELD NAME="cert_standard" TYPE="char" LENGTH="60" NOTNULL="true" DEFAULT="VietGAP" SEQUENCE="false"/>
        <FIELD NAME="phone" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="cohortid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_region" UNIQUE="false" FIELDS="region"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
