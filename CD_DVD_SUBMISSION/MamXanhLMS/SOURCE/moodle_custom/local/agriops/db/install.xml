<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/agriops/db" VERSION="20261107" COMMENT="VietGAP crop batches, voice cultivation logs, and QR traceability">
  <TABLES>
    <TABLE NAME="local_agriops_batch" COMMENT="VietGAP agricultural production batches">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="batch_code" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="product_name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="crop_variety" TYPE="char" LENGTH="120" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="region" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Lâm Đồng" SEQUENCE="false"/>
        <FIELD NAME="area_m2" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1000" SEQUENCE="false"/>
        <FIELD NAME="expected_yield_kg" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="500" SEQUENCE="false"/>
        <FIELD NAME="vietgap_status" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="active" SEQUENCE="false"/>
        <FIELD NAME="qr_token" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uq_batch_code" UNIQUE="true" FIELDS="batch_code"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_agriops_log" COMMENT="Cultivation field diary entries with Web Speech API support">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="batchid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="activity_type" TYPE="char" LENGTH="60" NOTNULL="true" DEFAULT="watering_fert" SEQUENCE="false"/>
        <FIELD NAME="notes" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="ph_val" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="6.0" SEQUENCE="false"/>
        <FIELD NAME="ec_val" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="1.6" SEQUENCE="false"/>
        <FIELD NAME="phi_days" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="voice_input" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="log_time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_batchid" TYPE="foreign" FIELDS="batchid" REFTABLE="local_agriops_batch" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
